# syntax=docker/dockerfile:1

FROM node:22-slim AS base
WORKDIR /app


# ---------------------------------------------------------------------------
# dev — используется в docker-compose.yml. Код перекрывается bind-mount'ом,
# поэтому здесь npm install ставит зависимости, а реальные исходники
# приедут из volume в compose (см. комментарий там же про node_modules).
# ---------------------------------------------------------------------------
FROM base AS dev
COPY package.json package-lock.json ./
RUN npm ci
COPY . .
EXPOSE 5173
CMD ["npm", "run", "dev", "--", "--host", "0.0.0.0"]


# ---------------------------------------------------------------------------
# build — компилирует статику. Отдельный от dev таргет, чтобы production-образ
# не тащил за собой vite dev-server и devDependencies.
#
# VITE_API_URL по умолчанию ПУСТА, и это принципиально: фронтенд обращается
# к API относительными путями (/api/v1/...), которые маршрутизирует обратный
# прокси. Пустое значение означает "тот же origin, что и страница".
#
# Почему не абсолютный адрес: Vite встраивает значение переменной прямо в
# JS-бандл на этапе `npm run build`, поэтому абсолютный адрес пришлось бы
# фиксировать при сборке образа. Один и тот же образ нельзя было бы
# использовать в разных окружениях, а смена IP сервера требовала бы
# пересборки. С относительными путями образ универсален.
#
# Аргумент оставлен для нештатных случаев — например, указать фронтенд на
# удалённый backend в обход прокси.
# ---------------------------------------------------------------------------
FROM base AS build
ARG VITE_API_URL=""
ENV VITE_API_URL=$VITE_API_URL
COPY package.json package-lock.json ./
RUN npm ci
COPY . .
RUN npm run build


# ---------------------------------------------------------------------------
# production — Nginx отдаёт статические файлы. Пригодится в Phase 3
# (сборка образа в CI, публикация в GHCR, деплой на домашний сервер).
# ---------------------------------------------------------------------------
FROM nginx:1.27-alpine AS production
COPY --from=build /app/dist /usr/share/nginx/html
COPY nginx.conf /etc/nginx/conf.d/default.conf
EXPOSE 80
# 127.0.0.1, а не localhost: nginx.conf слушает только IPv4 (`listen 80;`),
# а busybox-wget в Alpine может сначала попробовать IPv6-адрес ::1, на котором
# никто не слушает — healthcheck падал бы при полностью рабочем сайте.
HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
    CMD wget -qO- http://127.0.0.1:80 || exit 1
