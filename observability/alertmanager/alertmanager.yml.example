# ШАБЛОН. Скопируйте в alertmanager.yml (тот файл в .gitignore) и заполните
# chat_id. Токен бота положите отдельным файлом telegram_token рядом —
# он тоже в .gitignore.
#
#   cp alertmanager.yml.example alertmanager.yml
#   echo "123456:AAA..." > telegram_token
#
# Почему chat_id не в git: это персональный идентификатор чата. Почему токен
# отдельным файлом, а не в конфиге: Alertmanager не подставляет переменные
# окружения в конфигурацию, но поддерживает bot_token_file — это штатный
# способ не держать секрет в конфиге.
#
# Alertmanager решает задачи, которых нет у Prometheus: группировка,
# подавление, повторы и доставка в каналы.
#
# Prometheus только определяет, что условие выполнилось. Всё остальное —
# кому послать, как не заспамить, что подавить — работа Alertmanager.

global:
  # Если алерт перестал приходить от Prometheus, через это время он
  # считается разрешённым и приходит уведомление "resolved".
  resolve_timeout: 5m

route:
  # Группировка — главный механизм борьбы со спамом. Алерты с одинаковыми
  # значениями этих меток попадают в одно уведомление. Если разом отвалятся
  # backend и БД, придёт одно сообщение с двумя алертами, а не два письма.
  group_by: ["alertname", "service"]

  # Сколько ждать перед отправкой первого уведомления по новой группе.
  # Пауза нужна, чтобы связанные алерты успели накопиться и уехали одним
  # сообщением: при падении БД алерты сервисов приходят не одновременно.
  group_wait: 30s

  # Интервал между уведомлениями, если в существующую группу добавились
  # новые алерты.
  group_interval: 5m

  # Как часто напоминать о неразрешённом алерте. 4 часа — компромисс:
  # чаще превращается в спам и приучает игнорировать, реже создаёт риск
  # забыть про открытый инцидент.
  repeat_interval: 4h

  receiver: telegram

  routes:
    # Критичные алерты можно направить в отдельный канал с более частыми
    # напоминаниями. Пока получатель тот же — разделение появится, когда
    # каналов станет больше одного.
    - matchers:
        - severity = "critical"
      receiver: telegram
      repeat_interval: 1h

# Подавление: если уже известно о серьёзной проблеме, не нужно засыпать
# уведомлениями о её следствиях.
inhibit_rules:
  # Критичный алерт по сервису подавляет предупреждения по тому же сервису.
  # Пример: backend недоступен (critical) — предупреждение о высокой
  # латентности того же backend (warning) бесполезно, оно лишь следствие.
  - source_matchers:
      - severity = "critical"
    target_matchers:
      - severity = "warning"
    equal: ["service"]

  # Падение БД подавляет алерты backend: причина уже известна, отдельное
  # уведомление о высокой доле ошибок backend не добавляет информации.
  # Именно этот механизм не даёт получить двадцать писем от двадцати
  # сервисов, зависящих от одной упавшей базы.
  - source_matchers:
      - alertname = "PostgresDown"
    target_matchers:
      - service = "backend"

receivers:
  - name: telegram
    telegram_configs:
      - bot_token_file: /etc/alertmanager/telegram_token
        chat_id: 000000000  # заменить на свой
        parse_mode: HTML
        # send_resolved даёт уведомление о том, что проблема закрылась.
        # Без него остаётся неясно, инцидент ещё идёт или уже прошёл.
        send_resolved: true
        message: |
          {{ if eq .Status "firing" }}🔴{{ else }}🟢{{ end }} <b>{{ .Status | toUpper }}</b>
          {{ range .Alerts }}
          <b>{{ .Labels.alertname }}</b> ({{ .Labels.severity }})
          {{ .Annotations.summary }}

          {{ .Annotations.description }}
          {{ end }}
