# ШАБЛОН. Скопируйте в 10-postgres-secret.yaml (тот файл в .gitignore)
# и подставьте настоящий пароль:
#
#   cp 10-postgres-secret.example.yaml 10-postgres-secret.yaml
#   # затем отредактируйте значения
#
# ВАЖНО про Secret и безопасность.
#
# Объект называется Secret, но по умолчанию он НЕ зашифрован. В etcd значения
# хранятся закодированными в base64 — а base64 это кодировка, а не шифрование,
# раскодировать её может кто угодно одной командой:
#
#   kubectl get secret postgres -n taskflow -o jsonpath='{.data.password}' | base64 -d
#
# То есть Secret отличается от ConfigMap в основном тем, что значения не
# показываются в выводе по умолчанию и на них можно раздельно настроить права
# доступа. Настоящая защита требует включения шифрования в etcd на уровне
# кластера, а в production обычно берут внешнее хранилище — External Secrets
# Operator, Sealed Secrets или интеграцию с Vault. Это пункт 11 реестра
# техдолга, и Kubernetes его не закрывает сам по себе.
#
# stringData вместо data: позволяет писать значения открытым текстом,
# Kubernetes закодирует их сам. В поле data пришлось бы вручную кодировать
# в base64, что неудобно и провоцирует ошибки.

apiVersion: v1
kind: Secret
metadata:
  name: postgres
  namespace: taskflow
type: Opaque
stringData:
  POSTGRES_USER: taskflow
  POSTGRES_PASSWORD: CHANGE-ME-use-a-real-password
  POSTGRES_DB: taskflow
