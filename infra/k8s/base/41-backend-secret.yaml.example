# ШАБЛОН. Скопируйте в 41-backend-secret.yaml и подставьте значения.
# Расширение .yaml.example намеренно: kubectl apply -f каталог/ подхватывает
# только файлы с расширением .yaml, поэтому шаблон в кластер не уедет.
#
# DATABASE_URL хранится целиком в Secret, а не собирается из частей: пароль
# внутри строки подключения, а значит вся строка секретна. Разнести её на
# ConfigMap и Secret нельзя — Kubernetes не подставляет одно значение внутрь
# другого, эта задача решается либо шаблонизатором (Helm, Phase 8), либо
# сборкой строки в самом приложении.
#
# Имя хоста postgres — то самое DNS-имя, которое даёт Service. Внутри одного
# namespace достаточно короткого имени; полное выглядит как
# postgres.taskflow.svc.cluster.local.

apiVersion: v1
kind: Secret
metadata:
  name: backend
  namespace: taskflow
type: Opaque
stringData:
  DATABASE_URL: postgresql+asyncpg://taskflow:CHANGE-ME-password@postgres:5432/taskflow
  JWT_SECRET_KEY: CHANGE-ME-generate-with-secrets-token-urlsafe
