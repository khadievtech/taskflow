# ШАБЛОН. Скопируйте в values-secrets.yaml (тот файл в .gitignore) и
# подставьте настоящие значения:
#
#   cp values-secrets.yaml.example values-secrets.yaml
#
# Применяется ВТОРЫМ файлом -f при install/upgrade, поверх values.yaml --
# тот же паттерн разделения "публичный/секретный", что уже использовался
# для пароля Grafana и токена Telegram-бота.
#
#   helm install taskflow charts/taskflow \
#     --namespace taskflow --create-namespace \
#     -f charts/taskflow/values.yaml \
#     -f charts/taskflow/values-secrets.yaml

secrets:
  postgresPassword: "CHANGE-ME-use-a-real-password"
  jwtSecretKey: "CHANGE-ME-generate-with-secrets-token-urlsafe"
