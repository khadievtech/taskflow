# Скопируйте в .env и заполните реальными значениями.
# .env никогда не коммитится в git (см. .gitignore) — это базовое правило
# безопасности, чтобы секреты не утекли в историю репозитория.

APP_NAME=TaskFlow API
ENVIRONMENT=local
DEBUG=true

DATABASE_URL=postgresql+asyncpg://taskflow:taskflow@localhost:5432/taskflow

CORS_ORIGINS=["http://localhost:5173"]
