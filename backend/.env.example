# Скопируйте в .env и заполните реальными значениями.
# .env никогда не коммитится в git (см. .gitignore) — это базовое правило
# безопасности, чтобы секреты не утекли в историю репозитория.

APP_NAME=TaskFlow API
ENVIRONMENT=local
DEBUG=true

DATABASE_URL=postgresql+asyncpg://taskflow:taskflow@localhost:5432/taskflow

CORS_ORIGINS=["http://localhost:5173"]

# --- Аутентификация ---
# Сгенерировать: python -c "import secrets; print(secrets.token_urlsafe(48))"
# В production приложение НЕ ЗАПУСТИТСЯ со значением по умолчанию.
JWT_SECRET_KEY=dev-only-insecure-secret-change-me
ACCESS_TOKEN_EXPIRE_MINUTES=10080
# Включить ОБЯЗАТЕЛЬНО после появления HTTPS (Phase 5b).
COOKIE_SECURE=false
# Выключить после создания своей учётной записи.
ALLOW_REGISTRATION=true
